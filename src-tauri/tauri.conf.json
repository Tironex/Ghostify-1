{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghostify",
  "version": "0.1.0",
  "identifier": "dev.ghostify.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ../packages/ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../packages/ui build",
    "frontendDist": "../packages/ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ghostify",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data: https://*.scdn.co; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Themes and plugins for Spotify Desktop",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
